{
    "name": "iam-adty/empira-app",
    "description": "An Empira application, and the reference for how one is put together.",
    "type": "project",
    "license": "MIT",
    "require": {
        "iam-adty/empira-auth": "dev-main",
        "iam-adty/empira-principle": "dev-main",
        "monolog/monolog": "^3.12"
    },
    "require-dev": {
        "franzl/studio": "^0.16",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "tools/test",
        "setup": [
            "@migrate",
            "@seed"
        ],
        "migrate": "php vendor/bin/empira migrate",
        "seed": "php vendor/bin/empira seed",
        "serve": "php -S localhost:8000 -t public public/index.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "franzl/studio": true
        }
    },
    "repositories": [{
        "name": "empira-auth",
        "type": "path",
        "url": "../auth"
    }]
}
