# Copy this file to `.env` before running anything. It is gitignored, and the
# application will not start without it:
#
#     cp .env.example .env
#
# `.env` is the only source of this application's configuration. Anything
# exported in your shell is discarded before the file is read — see
# `App::CONFIG_KEYS`. That is deliberate, so "what is configured" has one
# answer you can read in one file, but it does mean a deployment has to supply
# a real `.env` rather than injected environment variables.

# Where the app lives.
#
# `local` unless you set otherwise. Modules read this to decide whether to
# register themselves at all: `empira-debug-tools` installs its routes and its
# profiler only when this names a development environment. Nothing else in the
# application branches on it.
APP_ENV=local

# Signs every component token. Generate one with:
#
#     php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#
# and paste it below. It must be at least 16 bytes, and it must NOT change
# between deploys or every link already sitting in a user's history stops
# working.
#
# There is no default. An empty or missing value stops `App::boot()` in every
# environment rather than falling back to something published in this file.
APP_SECRET=