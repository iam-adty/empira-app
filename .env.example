# Where the app lives.
#
# `local` unless you set otherwise. This is the flag that matters most: the
# placeholder secret below is only permitted when it reads `local`, so setting
# this to anything else makes `App::boot()` refuse to start rather than serve
# component URLs anybody can forge.
APP_ENV=local

# Signs every component token. Generate one with: php -r 'echo bin2hex(random_bytes(32));'
# It must be at least 16 bytes, and it must NOT change between deploys or every
# link already sitting in a user's history stops working.
APP_SECRET=dev-secret-change-me-please-32b